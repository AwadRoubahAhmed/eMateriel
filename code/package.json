    "jose": "^6.2.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
