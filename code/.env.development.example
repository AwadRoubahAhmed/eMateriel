# Copier ce fichier en .env.development (en production : définir ces variables chez l'hébergeur).
NODE_ENV=development
PORT=3000
# Adresse publique du site (sitemap, liens canoniques, retour de paiement Stripe)
SITE_URL=http://localhost:3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=emateriel_dev

# Secret des jetons de connexion : 32 caractères minimum, uniquement côté serveur.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Clé Stripe de TEST (sk_test_...) : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Dossier des images produits envoyées depuis le back-office
UPLOAD_DIR=storage
# Nombre de proxys devant le serveur (Hostinger : 1 ; 2 si Cloudflare est aussi en proxy)
TRUST_PROXY=1

# Variables lues par le navigateur (préfixe VITE_ : jamais de secret ici)
VITE_SITE_URL=http://localhost:3000
# Jeton Cloudflare Web Analytics (chargé seulement après accord cookies)
VITE_CF_ANALYTICS_TOKEN=

# Production uniquement : au premier démarrage, crée tables + catalogue si la base est vide,
# puis le compte administrateur (mot de passe : 8 caractères min., lettres et chiffres)
DB_AUTO_INIT=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
